// easy2type 设置面板。

import { Button, Switch, SpinBox, ComboBox, LineEdit } from "std-widgets.slint";

global Palette {
    out property <color> bg: #F8F9FA;
    out property <color> card: #FFFFFF;
    out property <color> accent: #4A90E2;
    out property <color> accent-hover: #3A7BD5;
    out property <color> text-primary: #2C3E50;
    out property <color> text-secondary: #7F8C8D;
    out property <color> border: #E8ECF0;
    out property <color> danger: #E5484D;
    out property <color> warn-bg: #FFF8E1;
}

component TitleButton inherits Rectangle {
    in property <int> icon-kind: 0;
    in property <bool> danger: false;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: 5px;
    background: transparent;

    Path {
        x: 12px;
        y: 12px;
        width: 12px;
        height: 12px;
        commands: root.icon-kind == 0
            ? "M 1 8 L 11 8"
            : root.icon-kind == 1
                ? "M 1 1 L 11 1 L 11 11 L 1 11 Z"
                : "M 2 2 L 10 10 M 10 2 L 2 10";
        stroke: root.danger && area.has-hover ? white : Palette.text-secondary;
        stroke-width: 1.4px;
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    states [
        hovered when area.has-hover && !root.danger : { background: #E8E8E8; }
        hovered-danger when area.has-hover && root.danger : { background: Palette.danger; }
    ]
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked;

    height: 48px;
    border-radius: 8px;
    background: root.selected ? Palette.accent : transparent;

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 700 : 400;
        color: root.selected ? white : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    states [
        hovered when area.has-hover && !root.selected : { background: Palette.border; }
    ]
}

component CheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 20px;
    height: 20px;
    border-radius: 4px;
    border-width: 2px;
    border-color: root.checked ? Palette.accent : Palette.border;
    background: root.checked ? Palette.accent : transparent;

    if root.checked: Text {
        text: "OK";
        font-size: 9px;
        font-weight: 700;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component FilterRow inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> title: "";
    in property <string> desc: "";
    callback toggled(bool);

    height: 72px;
    background: Palette.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    HorizontalLayout {
        padding: 14px;
        spacing: 10px;

        CheckBox { checked: root.checked; }

        VerticalLayout {
            spacing: 3px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: Palette.text-primary;
            }
            Text {
                text: root.desc;
                font-size: 11px;
                color: Palette.text-secondary;
            }
        }
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component SectionTitle inherits VerticalLayout {
    in property <string> title: "";
    in property <string> desc: "";

    spacing: 4px;
    Text {
        text: root.title;
        font-size: 17px;
        font-weight: 700;
        color: Palette.text-primary;
    }
    Text {
        text: root.desc;
        font-size: 11px;
        color: Palette.text-secondary;
    }
}

component Card inherits Rectangle {
    background: Palette.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
}

component ResizeHandle inherits Rectangle {
    in property <int> hit-test: 0;
    callback resize(int);

    background: transparent;
    area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(pe) => {
            if pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down {
                root.resize(root.hit-test);
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "easy2type 设置";
    preferred-width: 600px;
    preferred-height: 520px;
    min-width: 560px;
    min-height: 440px;
    no-frame: true;

    in-out property <bool> active: true;
    in-out property <string> toggle-shortcut: "Ctrl+T";
    in-out property <string> complete-shortcut: "Tab";
    in-out property <int> candidate-limit: 4;
    in-out property <int> current-section: 0;
    in-out property <bool> toggle-recording: false;
    in-out property <bool> complete-recording: false;
    in-out property <bool> is-maximized: false;
    in-out property <bool> filter-digits: false;
    in-out property <bool> filter-urls: false;
    in-out property <string> current-dictionary: "通用高频词库";
    in-out property <string> dictionary-path: "assets/words.txt";
    in-out property <string> overlay-skin-name: "memphis";
    in-out property <string> custom-skin-path: "";
    in-out property <string> status-message: "";
    in-out property <bool> status-error: false;

    callback toggle-active(bool);
    callback start-record-toggle-shortcut();
    callback start-record-complete-shortcut();
    callback cancel-recording();
    callback edit-candidate-limit(int);
    callback toggle-filter-digits(bool);
    callback toggle-filter-urls(bool);
    callback switch-dictionary(string);
    callback import-dictionary();
    callback switch-overlay-skin(string);
    callback import-custom-skin();
    callback start-drag();
    callback start-resize(int);
    callback window-hide();
    callback window-minimize();
    callback window-maximize-restore(bool);
    callback window-close();

    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            HorizontalLayout {
                height: 44px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 18px;
                        spacing: 8px;
                        Text {
                            text: "easy2type";
                            font-size: 15px;
                            font-weight: 700;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    drag := TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(pe) => {
                            if pe.button == PointerEventButton.left && pe.kind == PointerEventKind.down {
                                root.start-drag();
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-right: 10px;
                    spacing: 3px;
                    alignment: end;
                    TitleButton { icon-kind: 0; clicked => { root.window-minimize(); } }
                    TitleButton { icon-kind: 1; clicked => { root.window-maximize-restore(root.is-maximized); } }
                    TitleButton { icon-kind: 2; danger: true; clicked => { root.window-close(); } }
                }
            }

            Rectangle { height: 1px; background: Palette.border; }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 74px;
                    background: Palette.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        NavItem { label: "通用"; selected: root.current-section == 0; clicked => { root.current-section = 0; } }
                        NavItem { label: "过滤"; selected: root.current-section == 1; clicked => { root.current-section = 1; } }
                        NavItem { label: "词库"; selected: root.current-section == 2; clicked => { root.current-section = 2; } }
                        NavItem { label: "皮肤"; selected: root.current-section == 3; clicked => { root.current-section = 3; } }
                    }
                }

                Rectangle { width: 1px; background: Palette.border; }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: Palette.bg;

                    if root.current-section == 0: VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        SectionTitle {
                            title: "通用设置";
                            desc: "控制联想开关、快捷键与候选词数量。";
                        }

                        Card {
                            height: 74px;
                            HorizontalLayout {
                                padding: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "单词联想"; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                                    Text { text: "开启后实时显示预测与纠错候选。"; font-size: 11px; color: Palette.text-secondary; }
                                }
                                sw := Switch {
                                    checked: root.active;
                                    toggled => { root.toggle-active(sw.checked); }
                                }
                            }
                        }

                        Card {
                            height: 118px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "快捷键绑定"; font-size: 13px; font-weight: 700; color: Palette.text-primary; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "切换开关"; min-width: 72px; font-size: 12px; color: Palette.text-primary; vertical-alignment: center; }
                                    Text { text: root.toggle-recording ? "请按下快捷键..." : root.toggle-shortcut; horizontal-stretch: 1; font-size: 12px; color: Palette.text-primary; vertical-alignment: center; }
                                    Button { text: root.toggle-recording ? "取消" : "修改"; clicked => { if root.toggle-recording { root.toggle-recording = false; root.cancel-recording(); } else { root.start-record-toggle-shortcut(); } } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "补全快捷键"; min-width: 72px; font-size: 12px; color: Palette.text-primary; vertical-alignment: center; }
                                    Text { text: root.complete-recording ? "请按下快捷键..." : root.complete-shortcut; horizontal-stretch: 1; font-size: 12px; color: Palette.text-primary; vertical-alignment: center; }
                                    Button { text: root.complete-recording ? "取消" : "修改"; clicked => { if root.complete-recording { root.complete-recording = false; root.cancel-recording(); } else { root.start-record-complete-shortcut(); } } }
                                }
                            }
                        }

                        Card {
                            height: 72px;
                            HorizontalLayout {
                                padding: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: "候选词数量"; font-size: 14px; font-weight: 700; color: Palette.text-primary; }
                                    Text { text: "候选窗最多显示 4 到 9 个候选词。"; font-size: 11px; color: Palette.text-secondary; }
                                }
                                SpinBox {
                                    minimum: 4;
                                    maximum: 9;
                                    value: root.candidate-limit;
                                    edited(value) => { root.edit-candidate-limit(value); }
                                }
                            }
                        }
                    }

                    if root.current-section == 1: VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        SectionTitle {
                            title: "智能过滤";
                            desc: "这些选项现在可直接左键单击整行切换。";
                        }
                        FilterRow {
                            checked: root.filter-digits;
                            title: "忽略包含数字的文本";
                            desc: "例如 win10、v2ex 等混合输入。";
                            toggled(checked) => { root.toggle-filter-digits(checked); }
                        }
                        FilterRow {
                            checked: root.filter-urls;
                            title: "忽略网址与路径";
                            desc: "例如 https://example.com、C:\\path 等内容。";
                            toggled(checked) => { root.toggle-filter-urls(checked); }
                        }
                    }

                    if root.current-section == 2: VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        SectionTitle {
                            title: "词库管理";
                            desc: "导入自己的词库文件，重启应用后生效。";
                        }

                        Card {
                            height: 206px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "当前词库"; font-size: 13px; font-weight: 700; color: Palette.text-primary; }
                                ComboBox {
                                    current-value: root.current-dictionary;
                                    model: ["通用高频词库", "自定义导入词库"];
                                    selected(text) => {
                                        root.current-dictionary = text;
                                        root.switch-dictionary(text);
                                    }
                                }
                                Text { text: "导入格式：.txt / .tsv / .csv，每行 word 或 word<TAB>weight 或 word,weight。"; font-size: 11px; color: Palette.text-secondary; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text: root.dictionary-path;
                                        horizontal-stretch: 1;
                                        edited(text) => { root.dictionary-path = text; }
                                    }
                                    Button {
                                        text: "导入";
                                        clicked => {
                                            root.import-dictionary();
                                        }
                                    }
                                }
                                Text { text: "示例：hello,100 或 environment<TAB>80。权重越高越优先。"; font-size: 10px; color: Palette.text-secondary; }
                            }
                        }
                    }

                    if root.current-section == 3: VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        SectionTitle {
                            title: "候选窗皮肤";
                            desc: "切换输入法候选弹窗外观，重启应用后生效。";
                        }

                        Card {
                            height: 246px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "皮肤方案"; font-size: 13px; font-weight: 700; color: Palette.text-primary; }
                                ComboBox {
                                    current-value: root.overlay-skin-name;
                                    model: ["memphis", "light", "dark", "custom"];
                                    selected(text) => {
                                        root.overlay-skin-name = text;
                                        root.switch-overlay-skin(text);
                                    }
                                }
                                Text { text: "自定义皮肤格式：JSON 文件，颜色使用 #RRGGBB。"; font-size: 11px; color: Palette.text-secondary; }
                                Text { text: "字段：background、border、textPrimary、textSecondary、accent、selectedBackground、separator、fontName、fontHeight、cornerRadius。"; font-size: 10px; color: Palette.text-secondary; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text: root.custom-skin-path;
                                        horizontal-stretch: 1;
                                        edited(text) => { root.custom-skin-path = text; }
                                    }
                                    Button {
                                        text: "导入皮肤";
                                        clicked => {
                                            root.import-custom-skin();
                                        }
                                    }
                                }
                                Text { text: "示例：{\"background\":\"#20242B\",\"accent\":\"#7DD3FC\",\"fontName\":\"Segoe UI\",\"fontHeight\":20,\"cornerRadius\":12}"; font-size: 10px; color: Palette.text-secondary; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

            if root.status-message != "": Rectangle {
                height: 32px;
                background: root.status-error ? #FDECEC : #EAF7EF;
                Text {
                    text: root.status-message;
                    color: root.status-error ? Palette.danger : #237A43;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // 透明缩放热区，命中值对应 Win32 HT* 常量。
        ResizeHandle { x: 0px; y: 0px; width: 8px; height: 8px; hit-test: 13; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: parent.width - 8px; y: 0px; width: 8px; height: 8px; hit-test: 14; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: 0px; y: parent.height - 8px; width: 8px; height: 8px; hit-test: 16; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px; hit-test: 17; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: 0px; y: 8px; width: 6px; height: parent.height - 16px; hit-test: 10; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: parent.width - 6px; y: 8px; width: 6px; height: parent.height - 16px; hit-test: 11; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: 8px; y: 0px; width: parent.width - 16px; height: 6px; hit-test: 12; resize(value) => { root.start-resize(value); } }
        ResizeHandle { x: 8px; y: parent.height - 6px; width: parent.width - 16px; height: 6px; hit-test: 15; resize(value) => { root.start-resize(value); } }
    }
}
