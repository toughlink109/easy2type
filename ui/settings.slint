// easy2type v0.6.0 — 设置面板（左侧导航 + 右分控卡片）
// 视觉规范：扁平孟菲斯插画风 / 莫兰迪暖色系 / 12px 圆角

import { Button, Switch, SpinBox, ComboBox } from "std-widgets.slint";

// ═══════════════════════════════════════
// 全局配色 & 常量
// ═══════════════════════════════════════
global Palette {
    out property <color> bg: #F8F9FA;
    out property <color> card: #FFFFFF;
    out property <color> accent: #4A90E2;
    out property <color> accent-hover: #3A7BD5;
    out property <color> text-primary: #2C3E50;
    out property <color> text-secondary: #7F8C8D;
    out property <color> success: #27AE60;
    out property <color> border: #E8ECF0;
    out property <color> warn-bg: #FFF8E1;      // 录制态背景淡黄

    // Corporate Memphis 插画色板
    out property <color> coral: #FF6B6B;
    out property <color> sun: #FFD93D;
    out property <color> mint: #6BCB77;
    out property <color> sky: #4D96FF;
    out property <color> blush: #F8B4C1;
}

// ═══════════════════════════════════════
// 孟菲斯几何插画组件（必须在使用前定义）
// ═══════════════════════════════════════
component MemphisIllustration inherits Rectangle {
    background: transparent;
    clip: true;

    // ── 大圆（黄色主体） ──
    Rectangle {
        x: 220px;
        y: 8px;
        width: 62px;
        height: 62px;
        border-radius: 31px;
        background: Palette.sun;
        opacity: 0.85;
    }

    // ── 中型矩形-珊瑚色 ──
    Rectangle {
        x: 178px;
        y: 32px;
        width: 24px;
        height: 38px;
        border-radius: 6px;
        background: Palette.coral;
        opacity: 0.75;
    }

    Rectangle {
        x: 265px;
        y: 28px;
        width: 20px;
        height: 42px;
        border-radius: 5px;
        background: Palette.sky;
        opacity: 0.7;
    }

    // ── 小圆点装饰 ──
    Rectangle {
        x: 195px;
        y: 50px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Palette.mint;
    }

    Rectangle {
        x: 210px;
        y: 62px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Palette.coral;
    }

    Rectangle {
        x: 285px;
        y: 48px;
        width: 7px;
        height: 7px;
        border-radius: 3px;
        background: Palette.blush;
    }

    Rectangle {
        x: 300px;
        y: 60px;
        width: 5px;
        height: 5px;
        border-radius: 2px;
        background: Palette.sun;
    }

    // ── 左侧大圆环 ──
    Rectangle {
        x: 60px;
        y: 10px;
        width: 70px;
        height: 70px;
        border-radius: 35px;
        background: transparent;
        border-width: 4px;
        border-color: Palette.mint;
    }

    // ── 左下角方块 ──
    Rectangle {
        x: 80px;
        y: 48px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: Palette.sky;
    }

    Rectangle {
        x: 105px;
        y: 55px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: Palette.coral;
    }

    // ── 右侧半圆 ──
    Rectangle {
        x: 340px;
        y: 15px;
        width: 50px;
        height: 25px;
        border-top-left-radius: 25px;
        border-top-right-radius: 25px;
        border-bottom-left-radius: 0px;
        border-bottom-right-radius: 0px;
        background: Palette.blush;
        opacity: 0.7;
    }

    // ── 底部短线（代表键盘/输入） ──
    Rectangle {
        x: 160px;
        y: 72px;
        width: 40px;
        height: 8px;
        border-radius: 4px;
        background: Palette.text-secondary;
        opacity: 0.3;
    }
    Rectangle {
        x: 210px;
        y: 72px;
        width: 30px;
        height: 8px;
        border-radius: 4px;
        background: Palette.text-secondary;
        opacity: 0.25;
    }
    Rectangle {
        x: 250px;
        y: 72px;
        width: 35px;
        height: 8px;
        border-radius: 4px;
        background: Palette.text-secondary;
        opacity: 0.3;
    }

    Text {
        x: 130px;
        y: 78px;
        text: "type smarter";
        font-size: 10px;
        color: Palette.text-secondary;
        opacity: 0.5;
    }
}

// ═══════════════════════════════════════
// 自定义复选框（纯 Slint 绘制）
// ═══════════════════════════════════════
component CheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 20px;
    height: 20px;
    border-radius: 4px;
    border-width: 2px;
    border-color: root.checked ? Palette.accent : Palette.border;
    background: root.checked ? Palette.accent : transparent;

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    if root.checked: Text {
        text: "✓";
        color: white;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ═══════════════════════════════════════
// 左侧导航项
// ═══════════════════════════════════════
component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked;

    height: 52px;
    border-radius: 12px;
    background: root.selected ? Palette.accent : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.selected ? 700 : 400;
        color: root.selected ? white : Palette.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }

    states [
        hovered when touch.has-hover && !root.selected : { background: Palette.border; }
    ]
}

// ═══════════════════════════════════════
// 设置窗口主组件
// ═══════════════════════════════════════
export component SettingsWindow inherits Window {
    title: "easy2type";
    preferred-width: 600px;
    preferred-height: 480px;
    min-width: 560px;
    min-height: 440px;
    no-frame: true;

    // ══ 属性（Rust 端绑定） ══
    in-out property <bool> active: true;
    in-out property <string> toggle-shortcut: "Ctrl+T";
    in-out property <string> complete-shortcut: "Tab";
    in-out property <int> candidate-limit: 4;

    // v0.6.0 — 导航
    in-out property <int> current-section: 0;

    // v0.6.0 — 快捷键录制状态
    in-out property <bool> toggle-recording: false;
    in-out property <bool> complete-recording: false;

    // v0.6.0 — 智能黑名单
    in-out property <bool> filter-digits: false;
    in-out property <bool> filter-urls: false;

    // v0.6.0 — 词库管理
    in-out property <string> current-dictionary: "通用高频词库";

    // ══ 回调 → Rust 端处理 ══
    callback toggle-active(bool);

    // 快捷键录制
    callback start-record-toggle-shortcut();
    callback start-record-complete-shortcut();
    callback cancel-recording();

    // 候选词数量
    callback edit-candidate-limit(int);

    // 智能黑名单
    callback toggle-filter-digits(bool);
    callback toggle-filter-urls(bool);

    // 词库管理
    callback switch-dictionary(string);

    // 窗口控制
    callback start-drag();
    callback window-hide();

    // 通知（Rust → UI）
    callback notify-saved(string);
    callback notify-error(string);

    // ═════════════════════════════════
    // 根容器
    // ═════════════════════════════════
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.bg;
        border-radius: 18px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // ── 标题栏（拖拽区域） ──
            Rectangle {
                height: 44px;
                background: transparent;

                drag-area := TouchArea {
                    pointer-event(pe) => {
                        if (pe.kind == PointerEventKind.down) {
                            root.start-drag();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;
                    padding-top: 0px;
                    padding-bottom: 0px;

                    Text {
                        text: "easy2type";
                        font-size: 15px;
                        font-weight: 600;
                        color: Palette.text-primary;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // 关闭按钮
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: transparent;
                        close-touch := TouchArea {
                            clicked => { root.window-hide(); }
                        }
                        states [
                            hovered when close-touch.has-hover : { background: #E8E8E8; }
                        ]
                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Palette.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ── 分割线 ──
            Rectangle {
                height: 1px;
                background: Palette.border;
                horizontal-stretch: 1;
            }

            // ═════════════════════════
            // 主体：左导航 + 右面板
            // ═════════════════════════
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // ═══ 左侧导航栏 ═══
                Rectangle {
                    width: 64px;
                    background: Palette.card;

                    VerticalLayout {
                        padding-top: 16px;
                        spacing: 4px;

                        NavItem {
                            label: "通用";
                            selected: current-section == 0;
                            clicked => { current-section = 0; }
                        }
                        NavItem {
                            label: "过滤";
                            selected: current-section == 1;
                            clicked => { current-section = 1; }
                        }
                        NavItem {
                            label: "词库";
                            selected: current-section == 2;
                            clicked => { current-section = 2; }
                        }
                    }
                }

                // ── 竖分割线 ──
                Rectangle {
                    width: 1px;
                    background: Palette.border;
                }

                // ═══ 右侧内容面板 ═══
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: Palette.bg;

                    // ────────── 页 0：通用设置 ──────────
                    if current-section == 0: VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // 插画
                        MemphisIllustration { height: 80px; }

                        // 卡片：单词联想开关
                        Rectangle {
                            background: Palette.card;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "单词联想";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "开启后实时显示预测与纠错";
                                        font-size: 11px;
                                        color: Palette.text-secondary;
                                    }
                                }
                                sw := Switch {
                                    checked: root.active;
                                    toggled => {
                                        root.toggle-active(sw.checked);
                                    }
                                }
                            }
                        }

                        // 卡片：快捷键绑定（即按即录）
                        Rectangle {
                            background: Palette.card;
                            border-radius: 12px;
                            border-width: 1px;
                            // ⭐ 录制态蓝色高亮边框
                            border-color: (root.toggle-recording || root.complete-recording) ? Palette.accent : Palette.border;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: "快捷键绑定";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.text-primary;
                                }

                                // ── 切换开关 ──
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "切换开关";
                                        font-size: 12px;
                                        color: Palette.text-primary;
                                        min-width: 70px;
                                        vertical-alignment: center;
                                    }

                                    // 常态：显示快捷键
                                    if !root.toggle-recording: Rectangle {
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Palette.border;
                                        horizontal-stretch: 1;
                                        height: 30px;
                                        Text {
                                            text: root.toggle-shortcut;
                                            font-size: 12px;
                                            color: Palette.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    // 录制态：等待按键
                                    if root.toggle-recording: Rectangle {
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Palette.accent;
                                        background: Palette.warn-bg;
                                        horizontal-stretch: 1;
                                        height: 30px;
                                        Text {
                                            text: "⏳ 请按下快捷键...";
                                            font-size: 12px;
                                            color: Palette.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // 修改 / 取消按钮
                                    Rectangle {
                                        width: 50px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: root.toggle-recording ? Palette.coral : Palette.accent;
                                        btn-toggle := TouchArea {
                                            clicked => {
                                                if root.toggle-recording {
                                                    root.toggle-recording = false;
                                                    root.cancel-recording();
                                                } else {
                                                    root.start-record-toggle-shortcut();
                                                }
                                            }
                                        }
                                        states [
                                            hovered when btn-toggle.has-hover : { opacity: 0.85; }
                                        ]
                                        Text {
                                            text: root.toggle-recording ? "取消" : "修改";
                                            font-size: 11px;
                                            color: white;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // ── 补全快捷键 ──
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "补全快捷键";
                                        font-size: 12px;
                                        color: Palette.text-primary;
                                        min-width: 70px;
                                        vertical-alignment: center;
                                    }

                                    // 常态
                                    if !root.complete-recording: Rectangle {
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Palette.border;
                                        horizontal-stretch: 1;
                                        height: 30px;
                                        Text {
                                            text: root.complete-shortcut;
                                            font-size: 12px;
                                            color: Palette.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    // 录制态
                                    if root.complete-recording: Rectangle {
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Palette.accent;
                                        background: Palette.warn-bg;
                                        horizontal-stretch: 1;
                                        height: 30px;
                                        Text {
                                            text: "⏳ 请按下快捷键...";
                                            font-size: 12px;
                                            color: Palette.accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        width: 50px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: root.complete-recording ? Palette.coral : Palette.accent;
                                        btn-complete := TouchArea {
                                            clicked => {
                                                if root.complete-recording {
                                                    root.complete-recording = false;
                                                    root.cancel-recording();
                                                } else {
                                                    root.start-record-complete-shortcut();
                                                }
                                            }
                                        }
                                        states [
                                            hovered when btn-complete.has-hover : { opacity: 0.85; }
                                        ]
                                        Text {
                                            text: root.complete-recording ? "取消" : "修改";
                                            font-size: 11px;
                                            color: white;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 卡片：候选词数量
                        Rectangle {
                            background: Palette.card;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding: 14px;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "候选词数量";
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "OSD 悬浮窗最多显示的候选词数 (4~9)";
                                        font-size: 11px;
                                        color: Palette.text-secondary;
                                    }
                                }
                                spin := SpinBox {
                                    minimum: 4;
                                    maximum: 9;
                                    value: root.candidate-limit;
                                    edited(value) => {
                                        root.edit-candidate-limit(value);
                                    }
                                }
                            }
                        }
                    }

                    // ────────── 页 1：智能黑名单 ──────────
                    if current-section == 1: VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // 页标题
                        Text {
                            text: "智能黑名单";
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.text-primary;
                        }
                        Text {
                            text: "配置输入过滤规则，避免联想干扰";
                            font-size: 11px;
                            color: Palette.text-secondary;
                        }

                        // 卡片：忽略数字
                        Rectangle {
                            background: Palette.card;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 10px;

                                CheckBox {
                                    checked: root.filter-digits;
                                    toggled(checked) => {
                                        root.toggle-filter-digits(checked);
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "忽略包含数字的文本";
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "如 \"win10\", \"v2ex\" 等混合输入";
                                        font-size: 11px;
                                        color: Palette.text-secondary;
                                    }
                                }
                            }
                        }

                        // 卡片：忽略网址
                        Rectangle {
                            background: Palette.card;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.border;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 10px;

                                CheckBox {
                                    checked: root.filter-urls;
                                    toggled(checked) => {
                                        root.toggle-filter-urls(checked);
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "忽略网址与路径";
                                        font-size: 13px;
                                        font-weight: 500;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "如 https://www、C:\\path 等";
                                        font-size: 11px;
                                        color: Palette.text-secondary;
                                    }
                                }
                            }
                        }
                    }

                    // ────────── 页 2：词库管理 ──────────
                    if current-section == 2: VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // 页标题
                        Text {
                            text: "词库管理";
                            font-size: 16px;
                            font-weight: 600;
                            color: Palette.text-primary;
                        }
                        Text {
                            text: "选择输入联想使用的词库文件";
                            font-size: 11px;
                            color: Palette.text-secondary;
                        }

                        // 卡片
                        Rectangle {
                            background: Palette.card;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Palette.border;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;

                                Text {
                                    text: "当前词库";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Palette.text-primary;
                                }

                                cb := ComboBox {
                                    current-value: root.current-dictionary;
                                    model: ["通用高频词库", "计算机技术词库"];
                                    selected(text) => {
                                        root.current-dictionary = text;
                                        root.switch-dictionary(text);
                                    }
                                }

                                Text {
                                    text: "切换词库需重启应用后生效";
                                    font-size: 10px;
                                    color: Palette.text-secondary;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
