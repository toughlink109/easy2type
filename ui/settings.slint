// easy2type v0.4.0 — 设置面板
// 视觉规范：扁平孟菲斯插画风 / 莫兰迪暖色系 / 12px 圆角

import { Button, Switch, SpinBox, LineEdit } from "std-widgets.slint";

// ═══════════════════════════════════════
// 全局配色 & 常量
// ═══════════════════════════════════════
global Palette {
    out property <color> bg: #F8F9FA;
    out property <color> card: #FFFFFF;
    out property <color> accent: #4A90E2;
    out property <color> accent-hover: #3A7BD5;
    out property <color> text-primary: #2C3E50;
    out property <color> text-secondary: #7F8C8D;
    out property <color> success: #27AE60;
    out property <color> border: #E8ECF0;

    // Corporate Memphis 插画色板
    out property <color> coral: #FF6B6B;
    out property <color> sun: #FFD93D;
    out property <color> mint: #6BCB77;
    out property <color> sky: #4D96FF;
    out property <color> blush: #F8B4C1;
}

// ═══════════════════════════════════════
// 设置窗口主组件
// ═══════════════════════════════════════
export component SettingsWindow inherits Window {
    title: "easy2type";
    preferred-width: 480px;
    preferred-height: 420px;
    min-width: 420px;
    min-height: 380px;
    borderless: true;
    no-frame: true;

    // ══ 背景层（大圆角白色底） ══
    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.bg;
        border-radius: 18px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 0;

            // ── 标题栏（拖拽区域） ──
            Rectangle {
                height: 44px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;

                    // 标题
                    Text {
                        text: "easy2type";
                        font-size: 15px;
                        font-weight: 600;
                        color: Palette.text-primary;
                        vertical-alignment: center;
                    }

                    // 弹簧
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // 关闭按钮
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: transparent;
                        touch-area := TouchArea {
                            clicked => {
                                root.window-hide();
                            }
                        }
                        states [
                            hovered when touch-area.has-hover: {
                                background: #E8E8E8;
                            }
                        ]
                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Palette.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ── 滚动内容区 ──
            VerticalLayout {
                padding: 0 20px 20px 20px;
                spacing: 14px;

                // ═══════════════════════════
                // 1. 孟菲斯几何插画
                // ═══════════════════════════
                MemphisIllustration {
                    min-height: 90px;
                    max-height: 90px;
                }

                // ═══════════════════════════
                // 2. 卡片：全局开关
                // ═══════════════════════════
                Rectangle {
                    background: Palette.card;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding: 16px;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "单词联想";
                                font-size: 14px;
                                font-weight: 600;
                                color: Palette.text-primary;
                            }
                            Text {
                                text: "开启后实时显示预测与纠错";
                                font-size: 11px;
                                color: Palette.text-secondary;
                            }
                        }

                        sw := Switch {
                            checked: root.active;
                            toggled => {
                                root.toggle-active(sw.checked);
                            }
                        }
                    }
                }

                // ═══════════════════════════
                // 3. 卡片：快捷键绑定
                // ═══════════════════════════
                Rectangle {
                    background: Palette.card;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text {
                            text: "快捷键绑定";
                            font-size: 13px;
                            font-weight: 600;
                            color: Palette.text-primary;
                        }

                        // 切换开关快捷键
                        HorizontalLayout {
                            spacing: 12px;

                            Text {
                                text: "切换开关";
                                font-size: 12px;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                                min-width: 80px;
                            }

                            toggle-field := LineEdit {
                                text: root.toggle-shortcut;
                                placeholder-text: "Ctrl+T";
                                enabled: true;
                                horizontal-stretch: 1;
                                accepted(text) => {
                                    root.edit-toggle-shortcut(text);
                                }
                            }

                            Rectangle {
                                width: 60px;
                                height: 28px;
                                border-radius: 6px;
                                background: Palette.accent;
                                touch-area := TouchArea {
                                    clicked => {
                                        root.edit-toggle-shortcut(toggle-field.text);
                                    }
                                }
                                states [
                                    hovered when touch-area.has-hover: {
                                        background: Palette.accent-hover;
                                    }
                                ]
                                Text {
                                    text: "保存";
                                    font-size: 11px;
                                    color: #FFFFFF;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // 补全快捷键
                        HorizontalLayout {
                            spacing: 12px;

                            Text {
                                text: "补全快捷键";
                                font-size: 12px;
                                color: Palette.text-primary;
                                vertical-alignment: center;
                                min-width: 80px;
                            }

                            complete-field := LineEdit {
                                text: root.complete-shortcut;
                                placeholder-text: "Tab";
                                enabled: true;
                                horizontal-stretch: 1;
                                accepted(text) => {
                                    root.edit-complete-shortcut(text);
                                }
                            }

                            Rectangle {
                                width: 60px;
                                height: 28px;
                                border-radius: 6px;
                                background: Palette.accent;
                                touch-area := TouchArea {
                                    clicked => {
                                        root.edit-complete-shortcut(complete-field.text);
                                    }
                                }
                                states [
                                    hovered when touch-area.has-hover: {
                                        background: Palette.accent-hover;
                                    }
                                ]
                                Text {
                                    text: "保存";
                                    font-size: 11px;
                                    color: #FFFFFF;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ═══════════════════════════
                // 4. 卡片：候选词数量
                // ═══════════════════════════
                Rectangle {
                    background: Palette.card;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding: 16px;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "候选词数量";
                                font-size: 14px;
                                font-weight: 600;
                                color: Palette.text-primary;
                            }
                            Text {
                                text: "OSD 悬浮窗最多显示的候选词数 (4~9)";
                                font-size: 11px;
                                color: Palette.text-secondary;
                            }
                        }

                        spin := SpinBox {
                            minimum: 4;
                            maximum: 9;
                            value: root.candidate-limit;
                            edited(value) => {
                                root.edit-candidate-limit(value);
                            }
                        }
                    }
                }
            }
        }
    }

    // ══ 属性（Rust 端绑定） ══
    in-out property <bool> active: true;
    in-out property <string> toggle-shortcut: "Ctrl+T";
    in-out property <string> complete-shortcut: "Tab";
    in-out property <int> candidate-limit: 4;

    // ══ 回调 → Rust 端处理 ══
    callback toggle-active(bool);
    callback edit-toggle-shortcut(string);
    callback edit-complete-shortcut(string);
    callback edit-candidate-limit(int);
    callback window-hide();

    // ══ Rust → UI 通知 ══
    callback notify-saved(string);
    callback notify-error(string);
}

// ═══════════════════════════════════════
// 孟菲斯几何插画组件
// ═══════════════════════════════════════
component MemphisIllustration inherits Rectangle {
    background: transparent;
    clip: true;

    // ── 大圆（头部/灯泡） ──
    Rectangle {
        x: 220px;
        y: 8px;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: Palette.sun;
        opacity: 0.85;
    }

    // ── 中型歪矩形 — 代表打字效率 ──
    Rectangle {
        x: 178px;
        y: 32px;
        width: 24px;
        height: 38px;
        border-radius: 6px;
        background: Palette.coral;
        rotation-angle: 15deg;
        opacity: 0.75;
    }

    Rectangle {
        x: 265px;
        y: 28px;
        width: 20px;
        height: 42px;
        border-radius: 5px;
        background: Palette.sky;
        rotation-angle: -10deg;
        opacity: 0.7;
    }

    // ── 小圆点装饰（代表文字/字符） ──
    Rectangle {
        x: 195px;
        y: 50px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: Palette.mint;
    }

    Rectangle {
        x: 210px;
        y: 62px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: Palette.coral;
    }

    Rectangle {
        x: 285px;
        y: 48px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: Palette.blush;
    }

    Rectangle {
        x: 300px;
        y: 60px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: Palette.sun;
    }

    // ── 左侧大弧形（孟菲斯典型元素） ──
    Rectangle {
        x: 60px;
        y: 10px;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: transparent;
        border-width: 4px;
        border-color: Palette.mint;
    }

    // ── 左下角方块 ──
    Rectangle {
        x: 80px;
        y: 48px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        background: Palette.sky;
        rotation-angle: 30deg;
    }

    Rectangle {
        x: 105px;
        y: 55px;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: Palette.coral;
        rotation-angle: -25deg;
    }

    // ── 右侧半圆 ──
    Rectangle {
        x: 340px;
        y: 15px;
        width: 50px;
        height: 25px;
        border-radius: 25px 25px 0 0;
        background: Palette.blush;
        opacity: 0.7;
    }

    // ── 底部短线（代表键盘/输入） ──
    Rectangle {
        x: 160px;
        y: 72px;
        width: 40px;
        height: 8px;
        border-radius: 4px;
        background: Palette.text-secondary;
        opacity: 0.3;
    }
    Rectangle {
        x: 210px;
        y: 72px;
        width: 30px;
        height: 8px;
        border-radius: 4px;
        background: Palette.text-secondary;
        opacity: 0.25;
    }
    Rectangle {
        x: 250px;
        y: 72px;
        width: 35px;
        height: 8px;
        border-radius: 4px;
        background: Palette.text-secondary;
        opacity: 0.3;
    }

    Text {
        x: 130px;
        y: 78px;
        text: "type smarter";
        font-size: 10px;
        color: Palette.text-secondary;
        opacity: 0.5;
    }
}
